# Copy to .env.local (development) or set in the hosting dashboard (production).
# Every value is optional: without them the site still works, enquiries still open WhatsApp,
# and saved enquiries only go to the server log. See docs/ENQUIRIES.md.

# The public address, for the sitemap, canonical links and social previews
NEXT_PUBLIC_SITE_URL=

# Google Apps Script web app that appends each enquiry as a row in the enquiries sheet
ENQUIRY_SHEET_URL=

# Resend (https://resend.com) for the studio's enquiry email and the family's confirmation
RESEND_API_KEY=
# Where enquiries are sent
ENQUIRY_TO=hellothebliss@gmail.com
# A sender on a domain verified in Resend, for example: The Bliss <hello@theblissweddings.in>
ENQUIRY_FROM=

# Live Google rating (Places API, New). Without these the rating shown is the one in src/content/site.ts
GOOGLE_PLACES_API_KEY=
GOOGLE_PLACE_ID=
